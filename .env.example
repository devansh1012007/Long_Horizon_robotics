# RecoverGraph console — copy to .env and adjust.
# Used by the Next.js gateway (dashboard), the engine service, or both.

# ------------------------------------------------------------------ #
# Database (Prisma / SQLite). Relative URLs resolve against prisma/.
# Production docker-compose mounts ./data as a volume.
# ------------------------------------------------------------------
DATABASE_URL=file:../data/dashboard.db

# ------------------------------------------------------------------ #
# Engine service location.
#  - Sidecar mode (default): the Next.js server spawns ../engine on
#    127.0.0.1:3031 automatically. Leave ENGINE_URL unset.
#  - Remote mode: point ENGINE_URL at a standalone engine (e.g. the
#    container from docker-compose) and the gateway will not spawn one.
# ------------------------------------------------------------------
# ENGINE_URL=http://127.0.0.1:3031
# ENGINE_DIR=../engine
# PYTHON_BIN=python3
# ENGINE_LOG_DIR=.zscripts

# ------------------------------------------------------------------ #
# Engine service env (only needed when running it standalone)
# ------------------------------------------------------------------
# ENGINE_HOST=0.0.0.0
# ENGINE_PORT=3031
# ENGINE_DATA_DIR=./data/engine
# RG_ROOT=./recovergraph
# ENGINE_WORKERS=3
# ENGINE_MAX_QUEUE=48
# ENGINE_MAX_TOTAL=600

# ------------------------------------------------------------------ #
# Socket.io telemetry (client, baked at build time)
#  - sandbox/dev sidecar:      default below (gateway XTransformPort hack)
#  - behind deploy/nginx.conf: NEXT_PUBLIC_SOCKET_URL=/ and
#                              NEXT_PUBLIC_SOCKET_PATH=/socket.io/
# ------------------------------------------------------------------
# NEXT_PUBLIC_SOCKET_URL=/?XTransformPort=3031
# NEXT_PUBLIC_SOCKET_PATH=/

# ------------------------------------------------------------------ #
# Security / quotas
#  COOKIE_SECURE=1   set when serving over HTTPS (recommended in prod)
# ------------------------------------------------------------------
# COOKIE_SECURE=1
# MAX_ACTIVE_JOBS_PER_USER=2
